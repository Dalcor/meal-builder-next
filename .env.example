# Upstash Redis (KV).
# - Local dev: paste here from your Upstash dashboard or copy from Vercel
#   project env vars (vercel env pull .env.local).
# - Production: set these in Vercel → Project Settings → Environment Variables.
#   The Upstash marketplace integration injects them automatically.
# Legacy `KV_REST_API_*` names from Vercel KV are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# JWT secret for auth cookies. CHANGE THIS in production.
JWT_SECRET=

# Vercel Blob — фото продуктів (src/lib/images.ts). Створюється автоматично
# при прив'язці Blob store до проєкту у Vercel; локально — `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Google Gemini — розпізнавання КБЖУ з фото етикетки продукту (vision).
# Безкоштовний ключ: https://aistudio.google.com/apikey
# (Опційно GEMINI_MODEL, дефолт gemini-2.5-flash.)
GEMINI_API_KEY=
