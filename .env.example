# Upstash Redis (KV).
# - Local dev: paste here from your Upstash dashboard or copy from Vercel
#   project env vars (vercel env pull .env.local).
# - Production: set these in Vercel → Project Settings → Environment Variables.
#   The Upstash marketplace integration injects them automatically.
# Legacy `KV_REST_API_*` names from Vercel KV are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# JWT secret for auth cookies. CHANGE THIS in production.
JWT_SECRET=
